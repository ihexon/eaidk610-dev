/dts-v1/;
/plugin/;

/* EAIDK-610 board fixes. Type-C: fixed-5V PD, no DisplayPort. */
/ {
	fragment@0 {
		target = <&fusb0>;
		__overlay__ {
			vbus-supply = <&vcc5v0_typec_managed>;
			/* The original graph points to the now-disabled DWC3 node.
			 * fwnode connection lookup then selects this bridge reference.
			 */
			usb-role-switch = <&eaidk_typec_bridge>;
			connector {
				power-role = "dual";
				data-role = "dual";
				/* Prefer the peripheral role when connected to a PC. */
				try-power-role = "sink";
				/* Fixed PDO flags: dual role, external power, USB communication,
				 * data-role swap. No higher voltages: VBUS uses a 5V-only switch.
				 * Raw PDO cells keep this overlay directly compilable by dtc.
				 */
				source-pdos = <0x2e0190b4>; /* 5V, 1.8A; CC advertises 1.5A */
				sink-pdos = <0x2e01900a>; /* 5V, 100mA interface budget */
				op-sink-microwatt = <500000>;
				/* System power comes from the separate 12V input, not VBUS. */
				self-powered;
				/* Notify the extcon bridge about the connector orientation. */
				orientation-switch = <&eaidk_typec_bridge>;
			};
		};
	};
	fragment@1 {
		target = <&vcc5v0_typec>;
		__overlay__ { status = "disabled"; };
	};
	fragment@2 {
		target-path = "/";
		__overlay__ {
			vcc5v0_typec_managed: regulator-vcc5v0-typec-managed {
				compatible = "regulator-fixed";
				regulator-name = "vcc5v0_typec_managed";
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5000000>;
				gpio = <&gpio4 21 0>;
				enable-active-high;
				pinctrl-names = "default";
				pinctrl-0 = <&vcc5v0_typec_en>;
				vin-supply = <&vcc5v0_sys>;
				status = "okay";
			};
			eaidk_typec_bridge: typec-extcon {
				compatible = "linux,typec-extcon-bridge";
				usb-role-switch;
				orientation-switch;
			};
		};
	};
	fragment@3 {
		target = <&u2phy0>;
		__overlay__ {
			extcon = <&eaidk_typec_bridge>;
			extcon,ignore-usb;
		};
	};
	/* An overlay cannot remove the old usb-role-switch boolean. Keep
	 * that node disabled and describe the same controller without it,
	 * so DWC3 and USB2 PHY both consume the bridge's EXTCON_USB_HOST.
	 */
	fragment@4 {
		target = <&usbdrd_dwc3_0>;
		__overlay__ { status = "disabled"; };
	};
	fragment@5 {
		target = <&usbdrd3_0>;
		__overlay__ {
			#address-cells = <2>;
			#size-cells = <2>;
			usb-controller@fe800000 {
				compatible = "snps,dwc3";
				reg = <0 0xfe800000 0 0x100000>;
				interrupts = <0 105 4 0>;
				clocks = <&cru 129>, <&cru 246>, <&cru 131>;
				clock-names = "ref", "bus_early", "suspend";
				dr_mode = "otg";
				phys = <&u2phy0_otg>, <&tcphy0_usb3>;
				phy-names = "usb2-phy", "usb3-phy";
				phy_type = "utmi_wide";
				snps,dis_enblslpm_quirk;
				snps,dis-u2-freeclk-exists-quirk;
				snps,dis_u2_susphy_quirk;
				snps,dis-del-phy-power-chg-quirk;
				snps,dis-tx-ipgap-linecheck-quirk;
				snps,xhci-trb-ent-quirk;
				snps,usb3-phy-reset-quirk;
				power-domains = <&power 24>;
				extcon = <&eaidk_typec_bridge>;
				status = "okay";
			};
		};
	};
	/* The RK3399 Type-C PHY driver gets both its USB role and SuperSpeed
	 * lane orientation from extcon.  The orientation-switch boolean in the
	 * upstream tcphy0_usb3 node is not consumed by this driver.
	 */
	fragment@6 {
		target = <&tcphy0>;
		__overlay__ {
			extcon = <&eaidk_typec_bridge>;
		};
	};
	/* GPIO0_B3 drives the PT5305 speaker amplifier enable input. */
	fragment@7 {
		target-path = "/";
		__overlay__ {
			eaidk_speaker_amp: audio-amplifier {
				compatible = "simple-audio-amplifier";
				enable-gpios = <&gpio0 11 0>;
				pinctrl-names = "default";
				pinctrl-0 = <&eaidk_speaker_amp_enable>;
				sound-name-prefix = "Speaker Amp";
				VCC-supply = <&vcc5v0_sys>;
			};
		};
	};
	/* The upstream codec node carries legacy GPIO properties which the
	 * mainline RT5651 driver does not consume.  Describe both functions on
	 * their supported consumers instead: headphone detect on simple-card,
	 * and speaker enable on a simple audio amplifier.  HP_DET_H is active
	 * high according to the EAIDK-610 schematic.
	 */
	fragment@8 {
		target-path = "/rt5651-sound";
		__overlay__ {
			pinctrl-names = "default";
			pinctrl-0 = <&rt5651_hpcon>;
			simple-audio-card,aux-devs = <&eaidk_speaker_amp>;
			simple-audio-card,hp-det-gpios = <&gpio4 28 0>;
			simple-audio-card,widgets =
				"Microphone", "Mic Jack",
				"Microphone", "Internal Mic",
				"Headphone", "Headphones",
				"Speaker", "Internal Speaker";
			simple-audio-card,routing =
				"Mic Jack", "micbias1",
				/* MIC_IN1P is wired to codec IN3P, not IN1P. */
				"IN3P", "Mic Jack",
				"Internal Mic", "micbias1",
				"IN2P", "Internal Mic",
				"IN2N", "Internal Mic",
				"Headphones", "HPOL",
				"Headphones", "HPOR",
				"Internal Speaker", "Speaker Amp OUTL",
				"Internal Speaker", "Speaker Amp OUTR",
				"Speaker Amp INL", "HPOL",
				"Speaker Amp INR", "HPOR";
		};
	};
	fragment@9 {
		target = <&pinctrl>;
		__overlay__ {
			eaidk-audio {
				eaidk_speaker_amp_enable: speaker-amp-enable {
					rockchip,pins = <0 11 0 &pcfg_pull_down>;
				};
			};
			eaidk-sdmmc {
				eaidk_sdmmc_power: sdmmc-power {
					rockchip,pins = <0 1 0 &pcfg_pull_none>;
				};
			};
		};
	};
	/* Allow bare earlycon to locate the board's serial console. */
	fragment@10 {
		target-path = "/";
		__overlay__ {
			chosen {
				stdout-path = "/serial@ff1a0000:1500000n8";
			};
		};
	};
	/* MIC5088 is connected across IN2P/IN2N (schematic sheet 50). */
	fragment@11 {
		target = <&rt5651>;
		__overlay__ {
			realtek,in2-differential;
		};
	};
	fragment@12 {
		target-path = "/";
		__overlay__ {
			/* U2206 and U4002 are separate analog LDOs (sheet 21).
			 * Their enables follow VCC1V8_S3, not a software GPIO.
			 * Keep the existing always-on policy for these shared rails.
			 */
			eaidk_vcca0v9_s3: regulator-vcca0v9-s3 {
				compatible = "regulator-fixed";
				regulator-name = "vcca0v9_s3";
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-always-on;
				regulator-boot-on;
				vin-supply = <&vcc_1v8>;
			};
			eaidk_vcca1v8_s3: regulator-vcca1v8-s3 {
				compatible = "regulator-fixed";
				regulator-name = "vcca1v8_s3";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;
				vin-supply = <&vcc3v3_sys>;
			};
			/* U1377 RT9013-30GB; SDMMC0_PWR_H is GPIO0_A1. */
			eaidk_vcc3v0_sd: regulator-vcc3v0-sd {
				compatible = "regulator-fixed";
				regulator-name = "vcc3v0_sd";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;
				gpio = <&gpio0 1 0>;
				enable-active-high;
				pinctrl-names = "default";
				pinctrl-0 = <&eaidk_sdmmc_power>;
				vin-supply = <&vcc3v3_sys>;
			};
		};
	};
	fragment@13 {
		target = <&hdmi>;
		__overlay__ {
			avdd-0v9-supply = <&eaidk_vcca0v9_s3>;
			avdd-1v8-supply = <&eaidk_vcca1v8_s3>;
		};
	};
	/* The base vcca1v8_s3 label aliases the digital VCC1V8_S3 rail. */
	fragment@14 {
		target = <&saradc>;
		__overlay__ {
			vref-supply = <&eaidk_vcca1v8_s3>;
		};
	};
	fragment@15 {
		target = <&sdmmc>;
		__overlay__ {
			vmmc-supply = <&eaidk_vcc3v0_sd>;
			vqmmc-supply = <&vcc_sdio>;
			max-frequency = <200000000>;
			sd-uhs-sdr50;
			sd-uhs-sdr104;
		};
	};
	/* Armbian already describes the I2S2 -> HDMI audio link. */
	fragment@16 {
		target = <&hdmi_sound>;
		__overlay__ { status = "okay"; };
	};
	/* Keep the working eMMC power configuration and 200 MHz clock. */
	fragment@17 {
		target = <&sdhci>;
		__overlay__ {
			mmc-hs400-1_8v;
		};
	};
	/* EMMC_STRB has no external pull-down on the board. */
	fragment@18 {
		target = <&emmc_phy>;
		__overlay__ {
			rockchip,enable-strobe-pulldown;
		};
	};
};
