# Release defaults; board support itself lives in config/boards/eaidk610.csc.
ARMBIAN_BOARD=eaidk610
ARMBIAN_BRANCH=edge
ARMBIAN_KERNEL_SERIES=7.2
ARMBIAN_RELEASE=trixie
ARMBIAN_BUILD_MINIMAL=yes
