+	 * ensures the block states will always be reflected in the client's
+	 * sample outputs, even when the client provided an all zero value mask.
+	 */
+	cfg_cm[0] |= (0xF | enable_mask[0]);
+	cfg_cm[1] |= enable_mask[1];
 }
 
