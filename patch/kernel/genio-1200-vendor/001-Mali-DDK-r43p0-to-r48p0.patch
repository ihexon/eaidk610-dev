+/* Job control registers */
+/* status==active and _next == busy snapshot from last JOB_IRQ_CLEAR */
+#define JOB_IRQ_JS_STATE 0x010
+/* cycles to delay delivering an interrupt externally. The JOB_IRQ_STATUS
