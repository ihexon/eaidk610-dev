From: ihexon <zzheasy@gmail.com>
Subject: [PATCH] ASoC: rt5651: skip IRQ request when no codec interrupt is wired

EAIDK610 uses a separate GPIO jack detector on simple-audio-card and does
not describe a codec interrupt. Avoid requesting IRQ 0 in that case, while
retaining the existing unavailable-IRQ sentinel and real IRQ error handling.

Signed-off-by: ihexon <zzheasy@gmail.com>
---
diff --git a/sound/soc/codecs/rt5651.c b/sound/soc/codecs/rt5651.c
--- a/sound/soc/codecs/rt5651.c
+++ b/sound/soc/codecs/rt5651.c
@@ -2263,10 +2263,14 @@ static int rt5651_i2c_probe(struct i2c_client *i2c)
-	ret = devm_request_irq(&i2c->dev, rt5651->irq, rt5651_irq,
-			       IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING
-			       | IRQF_NO_AUTOEN, "rt5651", rt5651);
-	if (ret) {
-		dev_warn(&i2c->dev, "Failed to request IRQ %d: %d\n",
-			 rt5651->irq, ret);
+	if (rt5651->irq) {
+		ret = devm_request_irq(&i2c->dev, rt5651->irq, rt5651_irq,
+				       IRQF_TRIGGER_RISING | IRQF_TRIGGER_FALLING
+				       | IRQF_NO_AUTOEN, "rt5651", rt5651);
+		if (ret) {
+			dev_warn(&i2c->dev, "Failed to request IRQ %d: %d\n",
+				 rt5651->irq, ret);
+			rt5651->irq = -ENXIO;
+		}
+	} else {
 		rt5651->irq = -ENXIO;
 	}
 
 	ret = devm_snd_soc_register_component(&i2c->dev,
